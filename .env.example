# Copy this file to .env.local for local development.
# .env.local is gitignored and will not be committed.

# Local dev server URL
VITE_SITE_URL=http://localhost:5173

# WordPress GraphQL endpoint
# Use /graphql for local dev (Vite proxies it via vite.config.js)
# Use https://simplrdashboard.kinsta.cloud/graphql for direct server-side access
VITE_WPGRAPHQL_ENDPOINT=/graphql
VITE_WP_DEV_PROXY_TARGET=https://simplrdashboard.kinsta.cloud

# Site config
VITE_WP_SITE_NAME=Simplr
VITE_WORK_CONTENT_TYPE=WORK
VITE_THINKING_CONTENT_TYPE=POST
VITE_WORK_URI_BASE=/work/
VITE_THINKING_URI_BASE=/thinking/

# EmailJS
VITE_EMAILJS_SERVICE_ID=service_3oe9zjf
VITE_EMAILJS_TEMPLATE_ID=template_nq8fxl6
VITE_EMAILJS_PUBLIC_KEY=Iad2kKJhGWpBi0zlJ
